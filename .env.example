# Copy to .env.local, or run: vercel env pull .env.local

# Postgres connection string. On Vercel this is injected by the Neon integration (pooled URL).
DATABASE_URL=

# Signs Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob token for media. Injected by the Blob store; leave empty locally to use ./media on disk.
BLOB_READ_WRITE_TOKEN=

# Canonical site URL, used for the sitemap and metadata.
NEXT_PUBLIC_SITE_URL=https://galentinesglobal.com
