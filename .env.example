# Postgres connection string (Neon). The Vercel Neon integration sets this automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign Payload auth tokens: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Vercel Blob read/write token. Leave empty locally to store uploads in ./media instead.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
